# Copy this file to .env (same folder) and fill in your own values.
# .env is in .gitignore: never commit it. Placeholder values only in this file.
#
# Make a random secret or key in PowerShell (inside .\backend):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Local server
PORT=5000
HOST=127.0.0.1

# Local MongoDB (npm run db:local). Never put the Atlas address in a test or demo .env.
MONGO_URI=mongodb://127.0.0.1:27017/dlm_local

# At least 32 random characters (use the command above).
JWT_SECRET=replace_with_a_random_value_of_at_least_32_characters

# Frontend origins allowed to call the API (comma-separated, no trailing slash).
CLIENT_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# CNIC protection (decision D-007). Two DIFFERENT keys, each 32 random bytes in base64
# (44 characters ending in "="). Make each one with the command above.
# Losing CNIC_ENC_KEY makes every stored CNIC unreadable. See docs/SECURITY.md (key handling).
CNIC_ENC_KEY=replace_with_44_character_base64_key_number_1=
CNIC_HASH_KEY=replace_with_44_character_base64_key_number_2=

# Optional (local)
# TRUST_PROXY=0          # number of proxies in front of the API (0 locally)
# AUTH_RATE_LIMIT=10     # failed login/register attempts per IP per 15 minutes
# UPLOAD_RATE_LIMIT=30   # evidence uploads per IP per 15 minutes
# DB_TIMEOUT_MS=5000     # how long to wait for MongoDB before answering 503
# CRON_SECRET=replace_with_a_random_value_of_at_least_32_characters
#                        # Module 4: the daily cron (GET /api/cron/daily) needs "Authorization: Bearer <CRON_SECRET>".
#                        # Not set = the cron endpoint always answers 401 (bookings stay right without it).

# Production (Vercel backend project): never in a file inside the repository. Set every value as a
# Secret variable in Vercel (docs/DEPLOY-RUNBOOK.md). In production the server refuses to start if
# one is missing, if MONGO_URI points at this computer, or if CLIENT_ORIGIN is not https://.
# NODE_ENV=production
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/dlm_production?retryWrites=true&w=majority
# CLIENT_ORIGIN=https://your-frontend.vercel.app
# TRUST_PROXY=1          # required in production; see the IP check in the runbook
# SHOW_CLIENT_IP=0       # 1 only for the one-off IP check after deployment, then back to 0
